# Only Moundshroud's own program files are ever committed. Everything else in this folder
# (your notes, chats, vault, mail, photos index, downloads, AI models, libraries, music, the window's
# browser profile, snapshots and releases) is ignored, so it can never be uploaded by accident.
/*
!/.gitignore
!/README.md
!/START-HERE.txt
!/SNAPSHOTS.txt
!/VERSION
!/LICENSE
!/server.js
!/Listener.cs
!/setup.ps1
!/Setup-Moundshroud.bat
!/make-release.ps1
!/open-moundshroud.ps1
!/ocr.ps1
!/pc-volume.ps1
!/snapshot.ps1
!/restore-snapshot.ps1
!/apply-update.ps1
!/update.json
!/publish-update.ps1
!/RELEASE-NOTES.txt
!/restore-progress.ps1
!/install-art-model.ps1
!/install-music-model.ps1
!/install-video-model.ps1
!/install-gateway.ps1
!/install-song-tools.ps1
!/install-godot.ps1
!/install-godot-templates.ps1
!/install-mcode.ps1
!/requirements.txt
!/lib/
!/agent/
!/bin/
!/py/
!/web/
!/tests/
!/data/
/data/*
!/data/cmudict.dict
!/data/cmudict-LICENSE.txt
!/scripts/
/scripts/*
!/scripts/auto-commit.ps1
!/.dev/
/.dev/*
!/.dev/settings.json

# inside the allowed folders
/web/music/
__pycache__/
*.pyc
*.log
*.bak*

# ARTEX runtime: PostgreSQL binaries, its data, and the ARTEX binary (installed locally, not source)
/runtime/

# fetched by the fine-tune setup (llama.cpp GGUF converter)
/scripts/convert_hf_to_gguf.py

# defense-in-depth: never allow secrets, private keys, env files, or local author flags anywhere in the repo
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
/.author-copy
/data/globe-tiles/
/data/globe-packs/
/data/offline-adapters.json
